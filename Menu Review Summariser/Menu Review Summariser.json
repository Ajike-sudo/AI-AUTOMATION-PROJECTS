    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst groups = {};\n\nfor (const row of rows) {\n  const food = row.json['Food'];\n  const comment = row.json['Comment'];\n  if (food && comment) {\n    if (!groups[food]) groups[food] = [];\n    groups[food].push(comment);\n  }\n}\n\nreturn Object.entries(groups).map(([Food, comments]) => ({\n  json: {\n    Food,\n    allComments: comments.join(' | ')\n  }\n}));"
      },
