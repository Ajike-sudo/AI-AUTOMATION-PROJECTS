        "message": "=<div style=\"font-family: Arial, Helvetica, sans-serif; max-width: 600px; margin: 0 auto; background-color: #f4f4f4;\">   <div style=\"background-color: #1a2b4c; padding: 24px 32px; text-align: center;\">     <h1 style=\"color: #ffffff; font-size: 20px; margin: 0;\">Crestline Retail & Distribution Ltd</h1>   </div>   <div style=\"background-color: #ffffff; padding: 32px;\">     <p style=\"font-size: 15px; color: #333333; line-height: 1.6;\">       Dear {{ $json['Candidate Name'] }},     </p>     <p style=\"font-size: 15px; color: #333333; line-height: 1.6;\">       Thank you for applying for the {{ $json['Role Applied For'] }} role at Crestline Retail & Distribution Ltd, and for taking the time to share your CV and cover letter with us.     </p>     <p style=\"font-size: 15px; color: #333333; line-height: 1.6;\">       After careful review, we've decided not to move forward with your application for this particular role. This decision reflects our current needs for this position and not a judgment on your overall qualifications or potential.     </p>     <p style=\"font-size: 15px; color: #333333; line-height: 1.6;\">       We'll keep your details on file and encourage you to apply for future openings that match your background.     </p>     <p style=\"font-size: 15px; color: #333333; line-height: 1.6;\">       We wish you the best in your job search.     </p>   </div>   <div style=\"background-color: #1a2b4c; padding: 16px 32px; text-align: center;\">     <p style=\"color: #8a99b8; font-size: 11px; margin: 0;\">Crestline Retail & Distribution Ltd · Do not reply to this email</p>   </div> </div>",
