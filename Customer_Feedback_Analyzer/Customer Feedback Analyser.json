    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a customer feedback analyst for a restaurant.\n\nAnalyze this comment and return a JSON object with sentiment and category.\n\nComment: {{ $json['Comment'] }}\n\nSentiment options: Positive, Negative, Neutral\nCategory options: Food Quality, Delivery, Customer Service, Pricing, Positive\n\nReturn only this JSON with no explanation:\n{\"sentiment\": \"Negative\", \"score\": 3, \"category\": \"Food Quality\"}\n\nRules:\n- score is 1 to 10 where 1 is most negative and 10 is most positive\n- Pick exactly one category\n- If the comment is positive use Positive as the category",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        416,
        0
      ],
      "id": "baa664fa-ec1c-487c-888b-0f77e401a229",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "jsCode": "const llmItems = $input.all();\nconst sheetItems = $('Feedback Data').all();\n\nreturn llmItems.map((item, index) => {\n  const raw = String(item.json.text || '');\n  \n  const cleaned = raw\n    .replace(/```json\\n/g, '')\n    .replace(/```\\n/g, '')\n    .replace(/```/g, '')\n    .trim();\n\n  let sentiment = 'Unknown';\n  let score = 0;\n  let category = 'Uncategorised';\n\n  try {\n    const parsed = JSON.parse(cleaned);\n    sentiment = String(parsed.sentiment || 'Unknown');\n    score = Number(parsed.score || 0);\n    category = String(parsed.category || 'Uncategorised');\n  } catch(e) {\n    // keep defaults\n  }\n\n  const original = sheetItems[index].json;\n\n  return {\n    json: {\n      ...original,\n      sentiment,\n      score,\n      category\n    }\n  };\n});"
      },
