    {
      "parameters": {
        "sendTo": "={{ $json.Email }}",
        "subject": "=We'd Love to Work With You, {{ $json['Full Name'] }}",
        "message": "=<!DOCTYPE html>\n<html>\n  <body style=\"margin: 0; padding: 0; background-color: #f4f4f4; font-family: Arial, sans-serif;\">\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #f4f4f4; padding: 40px 0;\">\n      <tr>\n        <td align=\"center\">\n          <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08);\">\n            <!-- Header -->\n            <tr>\n              <td style=\"background-color: #27AE60; padding: 36px 40px; text-align: center;\">\n                <p style=\"margin: 0; font-size: 13px; color: #a9dfbf; letter-spacing: 2px; text-transform: uppercase;\">Legacy Farms</p>\n                <h1 style=\"margin: 12px 0 0; font-size: 26px; color: #ffffff; font-weight: 700;\">We'd Love to Work With You</h1>\n              </td>\n            </tr>\n            <!-- Body -->\n            <tr>\n              <td style=\"padding: 40px 40px 32px;\">\n                <p style=\"margin: 0 0 20px; font-size: 15px; color: #333333; line-height: 1.8;\">\n                  Hi <strong>{{ $json['Full Name'] }}</strong>,\n                </p>\n                <p style=\"margin: 0 0 20px; font-size: 15px; color: #555555; line-height: 1.8;\">\n                  Thank you for registering with Legacy Farms. We've reviewed your profile and we're excited about the opportunity to work with you on your <strong>{{ $json['Crop Type'] }}</strong> farm in <strong>{{ $json['Location'] }}</strong>.\n                </p>\n                <p style=\"margin: 0 0 20px; font-size: 15px; color: #555555; line-height: 1.8;\">\n                  Based on your farm size of <strong>{{ $json['Farm Size (acres)'] }} acres</strong>, we believe there's a strong case for a partnership that works well for both sides. We'd love to walk you through what we can offer and how we can help you maximise your returns this season.\n                </p>\n                <p style=\"margin: 0 0 24px; font-size: 15px; color: #555555; line-height: 1.8;\">\n                  Someone from our team will be reaching out to you shortly. In the meantime, feel free to get in touch.\n                </p>\n                <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"text-align: center;\">\n                  <tr>\n                    <td align=\"center\" style=\"text-align: center;\">\n                      <a href=\"mailto:info@legacyfarms.com\" style=\"display: inline-block; background-color: #27AE60; color: #ffffff; text-decoration: none; font-size: 15px; font-weight: 600; padding: 14px 36px; border-radius: 6px;\">Get in Touch</a>\n                    </td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n            <!-- Footer -->\n            <tr>\n              <td style=\"background-color: #f4f4f4; padding: 24px 40px; text-align: center; border-top: 1px solid #e0e0e0;\">\n                <p style=\"margin: 0 0 6px; font-size: 13px; color: #999999;\">Legacy Farms</p>\n                <p style=\"margin: 0 0 6px; font-size: 13px; color: #999999;\">Osogbo, Osun State, Nigeria</p>\n                <p style=\"margin: 0; font-size: 12px; color: #bbbbbb;\">You're receiving this because you recently registered with Legacy Farms.</p>\n              </td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>",
        "options": {}
      },
