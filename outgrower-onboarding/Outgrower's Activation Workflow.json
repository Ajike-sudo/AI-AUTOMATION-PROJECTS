    {
      "parameters": {
        "sendTo": "={{ $json.Email }}",
        "subject": "=Welcome to Hastom Grower Network, {{ $json['Full name'] }}",
        "message": "=<p>Dear {{ $json['Full name'] }},</p>\n\n<p>We're glad to have you as part of the Hastom Grower Network. Your registration has been received and your profile is now active in our system.</p>\n\n<p>{{ $('Edit Fields').item.json['Manager Assigned'] }} is your dedicated point of contact for everything — supply schedules, payments, field support, and any questions you have along the way.</p>\n\n<p>You should get contacted within 48 hours to schedule an onboarding call, during that call, you'll go over farm assessment, quality standards, and your first supply agreement. Once your farm is verified, you'll be officially added to our active grower list.</p>\n\n<p>Hastom Food & Farms is building Nigeria's most reliable outgrower network for agro-commodities. As a network member, you get access to guaranteed offtake, fair pricing, and agronomy support designed to improve your yield and income over time.</p>\n\n<p>If you have any immediate questions, reply to this email or call us at 08163013001.</p>\n\n<p>Welcome aboard.</p>\n\n<p>Warm regards, \n<br>Head of Operations</p>",
        "options": {}
      },
