    {
      "parameters": {
        "sendTo": "onisemotobi@gmail.com",
        "subject": "=Approval needed: Invoice {{ $json['Invoice number'] }} from {{ $json['Vendor name'] }} (NGN {{ Number($json['Total Amount'].toString().replace(/[^0-9.]/g, '')).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}) }})",
        "message": "=<div style=\"font-family: Arial, Helvetica, sans-serif; max-width: 600px; margin: 0 auto; background-color: #f4f4f4;\">\n  <div style=\"background-color: #1a2b4c; padding: 24px 32px; text-align: center;\">\n    <h1 style=\"color: #ffffff; font-size: 20px; margin: 0;\">Crestline Retail & Distribution Ltd</h1>\n    <p style=\"color: #b8c2d6; font-size: 13px; margin: 4px 0 0 0;\">Invoice Approval Required</p>\n  </div>\n  <div style=\"background-color: #ffffff; padding: 32px;\">\n    <p style=\"font-size: 15px; color: #333333; line-height: 1.5;\">\n      An invoice above the <strong>₦500,000</strong> auto-approval threshold was just extracted and needs sign-off before payment.\n    </p>\n    <table style=\"width: 100%; border-collapse: collapse; margin: 24px 0;\">\n      <tr><td style=\"padding: 8px 0; color: #666666; font-size: 14px; width: 140px;\">Vendor</td><td style=\"padding: 8px 0; color: #111111; font-size: 14px; font-weight: bold;\">{{ $json['Vendor name'] }}</td></tr>\n      <tr><td style=\"padding: 8px 0; color: #666666; font-size: 14px;\">Invoice #</td><td style=\"padding: 8px 0; color: #111111; font-size: 14px;\">{{ $json['Invoice number'] }}</td></tr>\n      <tr><td style=\"padding: 8px 0; color: #666666; font-size: 14px;\">Invoice date</td><td style=\"padding: 8px 0; color: #111111; font-size: 14px;\">{{ $json['Invoice date'] }}</td></tr>\n      <tr><td style=\"padding: 8px 0; color: #666666; font-size: 14px;\">Due date</td><td style=\"padding: 8px 0; color: #111111; font-size: 14px;\">{{ $json['Due date'] }}</td></tr>\n      <tr><td style=\"padding: 8px 0; color: #666666; font-size: 14px;\">Source file</td><td style=\"padding: 8px 0; color: #111111; font-size: 14px;\">{{ $json['Source file name'] }}</td></tr>\n    </table>\n    <div style=\"background-color: #fff4e5; border-left: 4px solid #e8891c; padding: 16px 20px; margin: 24px 0;\">\n      <p style=\"margin: 0; font-size: 13px; color: #8a5a12;\">AMOUNT DUE</p>\n      <p style=\"margin: 4px 0 0 0; font-size: 24px; color: #1a2b4c; font-weight: bold;\">{{ $json.Currency }} {{ Number($json['Total Amount'].toString().replace(/[^0-9.]/g, '')).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}) }}</p>\n    </div>\n    <p style=\"font-size: 13px; color: #666666; margin-top: 28px; margin-bottom: 8px;\">Line items</p>\n    <div style=\"background-color: #fafafa; border: 1px solid #eeeeee; border-radius: 4px; padding: 4px 16px;\">\n      {{ $json.line_items_html.split('\\n').map(line => {\n        let parts = line.split(', ');\n        let desc = parts[0] ? parts[0].replace('description:', '') : '';\n        let qty = parts[1] ? parts[1].replace('quantity:', '') : '';\n        let unitRaw = parts[2] ? parts[2].replace('unit_price:', '') : '0';\n        let totalRaw = parts[3] ? parts[3].replace('line_total:', '') : '0';\n        \n        let unitNum = Number(unitRaw.toString().replace(/[^0-9.]/g, '')).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});\n        let totalNum = Number(totalRaw.toString().replace(/[^0-9.]/g, '')).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});\n\n        return '<div style=\"padding:12px 0;border-top:1px solid #eeeeee;\"><div style=\"font-weight:bold;color:#111111;font-size:14px;margin-bottom:4px;\">' + desc + '</div><div style=\"font-size:13px;color:#666666;\">Qty ' + qty + ' · Unit ₦' + unitNum + ' · Total ₦' + totalNum + '</div></div>';\n      }).join('') }}\n    </div>\n    <p style=\"font-size: 12px; color: #999999; font-style: italic; margin-top: 16px;\">This is an AI extraction, confirm against the source document before approving payment.</p>\n  </div>\n  <div style=\"background-color: #1a2b4c; padding: 16px 32px; text-align: center;\">\n    <p style=\"color: #8a99b8; font-size: 11px; margin: 0;\">Crestline Retail & Distribution Ltd · Automated Invoice Processing · Do not reply to this email</p>\n  </div>\n</div>",
        "options": {
          "appendAttribution": false
        }
