        "message": "=<div style=\"font-family: Arial, Helvetica, sans-serif; max-width: 600px; margin: 0 auto; background-color: #f4f4f4;\">\n  \n  <div style=\"background-color: #1a2b4c; padding: 24px 32px; text-align: center;\">\n    <h1 style=\"color: #ffffff; font-size: 20px; margin: 0;\">Crestline Retail & Distribution Ltd</h1>\n    <p style=\"color: #b8c2d6; font-size: 13px; margin: 4px 0 0 0;\">\n      Invoice Approved for Processing\n    </p>\n  </div>\n\n  <div style=\"background-color: #ffffff; padding: 32px;\">\n\n    <p style=\"font-size: 15px; color: #333333; line-height: 1.6;\">\n      An invoice below the <strong>₦500,000</strong> approval threshold has been successfully extracted and approved for payment processing.\n    </p>\n\n    <p style=\"font-size: 15px; color: #333333; line-height: 1.6;\">\n      Please process payment within <strong>48 hours</strong> in line with the company's payment policy.\n    </p>\n\n    <table style=\"width: 100%; border-collapse: collapse; margin: 24px 0;\">\n      <tr>\n        <td style=\"padding: 8px 0; color: #666666; font-size: 14px; width: 140px;\">Vendor</td>\n        <td style=\"padding: 8px 0; color: #111111; font-size: 14px; font-weight: bold;\">\n          {{ $json['Vendor name'] }}\n        </td>\n      </tr>\n\n      <tr>\n        <td style=\"padding: 8px 0; color: #666666; font-size: 14px;\">Invoice #</td>\n        <td style=\"padding: 8px 0; color: #111111; font-size: 14px;\">\n          {{ $json['Invoice number'] }}\n        </td>\n      </tr>\n\n      <tr>\n        <td style=\"padding: 8px 0; color: #666666; font-size: 14px;\">Invoice date</td>\n        <td style=\"padding: 8px 0; color: #111111; font-size: 14px;\">\n          {{ $json['Invoice date'] }}\n        </td>\n      </tr>\n\n      <tr>\n        <td style=\"padding: 8px 0; color: #666666; font-size: 14px;\">Due date</td>\n        <td style=\"padding: 8px 0; color: #111111; font-size: 14px;\">\n          {{ $json['Due date'] }}\n        </td>\n      </tr>\n\n      <tr>\n        <td style=\"padding: 8px 0; color: #666666; font-size: 14px;\">Source file</td>\n        <td style=\"padding: 8px 0; color: #111111; font-size: 14px;\">\n          {{ $json['Source file name'] }}\n        </td>\n      </tr>\n    </table>\n\n    <div style=\"background-color:#eaf7ee;border-left:4px solid #2e7d32;padding:16px 20px;margin:24px 0;\">\n\n      <p style=\"margin:0;font-size:13px;color:#2e7d32;font-weight:bold;\">\n        PAYMENT STATUS\n      </p>\n\n      <p style=\"margin:6px 0 0 0;font-size:22px;color:#1a2b4c;font-weight:bold;\">\n        Approved for Processing\n      </p>\n\n      <p style=\"margin:14px 0 0 0;font-size:14px;color:#555555;\">\n        Amount Due\n      </p>\n\n      <p style=\"margin:4px 0 0 0;font-size:28px;color:#1a2b4c;font-weight:bold;\">\n        {{ $json.Currency }}\n        {{ Number($json['Total Amount'].toString().replace(/[^0-9.]/g, '')).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}) }}\n      </p>\n\n      <p style=\"margin:12px 0 0 0;font-size:13px;color:#555555;\">\n        Please ensure payment is completed within\n        <strong>48 hours.</strong>\n      </p>\n\n    </div>\n\n    <p style=\"font-size:13px;color:#666666;margin-top:28px;margin-bottom:8px;\">\n      Line Items\n    </p>\n\n    <div style=\"background-color:#fafafa;border:1px solid #eeeeee;border-radius:4px;padding:4px 16px;\">\n\n      {{\n      $json.line_items_html\n      .split('\\n')\n      .map(line => {\n\n        let parts = line.split(', ');\n\n        let desc = parts[0] ? parts[0].replace('description:', '') : '';\n        let qty = parts[1] ? parts[1].replace('quantity:', '') : '';\n        let unitRaw = parts[2] ? parts[2].replace('unit_price:', '') : '0';\n        let totalRaw = parts[3] ? parts[3].replace('line_total:', '') : '0';\n\n        let unitNum = Number(\n          unitRaw.toString().replace(/[^0-9.]/g,'')\n        ).toLocaleString('en-US',{\n          minimumFractionDigits:2,\n          maximumFractionDigits:2\n        });\n\n        let totalNum = Number(\n          totalRaw.toString().replace(/[^0-9.]/g,'')\n        ).toLocaleString('en-US',{\n          minimumFractionDigits:2,\n          maximumFractionDigits:2\n        });\n\n        return `\n          <div style=\"padding:12px 0;border-top:1px solid #eeeeee;\">\n            <div style=\"font-weight:bold;color:#111111;font-size:14px;margin-bottom:4px;\">\n              ${desc}\n            </div>\n\n            <div style=\"font-size:13px;color:#666666;\">\n              Qty ${qty}\n              &nbsp;&nbsp;•&nbsp;&nbsp;\n              Unit ₦${unitNum}\n              &nbsp;&nbsp;•&nbsp;&nbsp;\n              Total ₦${totalNum}\n            </div>\n          </div>\n        `;\n\n      }).join('')\n      }}\n\n    </div>\n\n    <p style=\"font-size:12px;color:#999999;font-style:italic;margin-top:18px;\">\n      This invoice was automatically approved because it falls below the company's ₦500,000 approval threshold. Please verify the extracted information against the source document before processing payment.\n    </p>\n\n  </div>\n\n  <div style=\"background-color:#1a2b4c;padding:16px 32px;text-align:center;\">\n    <p style=\"color:#8a99b8;font-size:11px;margin:0;\">\n      Crestline Retail & Distribution Ltd · Automated Invoice Processing · Do not reply to this email\n    </p>\n  </div>\n\n</div>",
